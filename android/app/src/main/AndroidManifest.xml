<!-- AndroidManifest.xml (main) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- İnternet izni -->
    <uses-permission android:name="android.permission.INTERNET"/>
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

	<!-- Camera permissions -->
	<uses-permission android:name="android.permission.CAMERA"/>

	<!-- Reklam kimliği YOK (kullanıcı kararı 12 Kas 2026): firebase_analytics (play-services-measurement)
	     AD_ID iznini birleştirmeyle ekliyor; Play beyanı "AD_ID kullanılmıyor" aynı kalsın diye silinir. -->
	<uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
	<!-- Aynı karar: Privacy Sandbox reklam kimliği / atıf izinleri de (play-services-measurement ekliyor).
	     Play Install Referrer (BIND_GET_INSTALL_REFERRER_SERVICE) reklam kimliği değil, kalır. -->
	<uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
	<uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
	<uses-feature android:name="android.hardware.camera" android:required="false"/>
	<uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
	<!-- camera_android_camerax, camera.any'yi zorunlu bildiriyor: kamerasız 117 cihaz (tablet/Chromebook)
	     Play'de dışlanıyordu. Katalog kamerasız da kullanılır → isteğe bağlı (2026-09-29). -->
	<uses-feature android:name="android.hardware.camera.any" android:required="false"
		tools:replace="android:required"/>

    <!-- Android 11+ browser intent requirement -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <!-- Hesabım → "Hesabımı sil": hazır silme talebi e-postası -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Explicit browser packages for Auth0 -->
        <package android:name="com.android.chrome" />
        <package android:name="com.android.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="org.mozilla.firefox" />
    </queries>

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">

        <!-- Antik harita: Google Maps SDK anahtarı (build.gradle.kts → key.properties `mapsApiKey`) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">

            <!-- flutter embedding -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Separate activity for auth redirect handling -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            android:theme="@style/AuthRedirectTheme"
            tools:node="replace">

            <!-- Auth0 callback -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="${appAuthRedirectScheme}"
                    android:host="callback"/>
            </intent-filter>

            <!-- Logout callback -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="${appAuthRedirectScheme}"
                    android:host="logout"/>
            </intent-filter>
        </activity>

        <!-- Flutter'ın splash sırasındaki arka planı -->
        <meta-data android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase Analytics: onaya dek HİÇ veri gitmez (Consent Mode temel). Uygulama
             kullanıcı "İzin ver" deyince setAnalyticsCollectionEnabled(true) + setConsent çağırır
             (lib/src/core/analytics/app_analytics.dart). Kişiselleştirme sinyali hep kapalı. -->
        <!-- Firebase YALNIZ ONAYLA başlar (13 Kas 2026): google_app_id kaynağı varken
             FirebaseInitProvider varsayılan uygulamayı süreç açılırken kendiliğinden başlatıyordu.
             Silinince Firebase'i yalnız Dart (AppAnalytics, onaydan sonra) başlatır;
             ölçüm google_app_id'yi yine kaynaktan okur (build.gradle.kts resValue). -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
    </application>
</manifest>
