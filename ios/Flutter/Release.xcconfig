#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Xcode 27 lipo'su `-verify_arch arm64 x86_64` (çok mimari) kabul etmiyor; Flutter 3.35.6 simülatör derlemesinde
// ikisini birden doğruladığı için debug_unpack_ios düşüyordu (2026-10-10). Simülatör yalnız arm64 (Apple Silicon);
// Generated.xcconfig'in i386 dışlamasını da korur. Cihaz (iphoneos) derlemesine etkisi yok.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386 x86_64
