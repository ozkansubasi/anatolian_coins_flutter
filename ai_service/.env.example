# NumisTR AI Service Environment Variables
# Copy this file to .env and fill in the values

# ===== Model Paths =====
EFFICIENTNET_PATH=models/efficientnet_b3_coins_quantized.onnx
FAISS_INDEX_PATH=index/coins.index
FAISS_METADATA_PATH=index/metadata.json

# ===== Recognition Settings =====
TOP_K=50
CONFIDENCE_THRESHOLD=0.6
OCR_MIN_CONFIDENCE=0.5

# ===== Google AutoML (Optional - for fallback) =====
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_MODEL_ID=your-model-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-credentials.json

# ===== Database Configuration =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=joomla_numistr
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ===== FastAPI Settings =====
WORKERS=4
LOG_LEVEL=info
CORS_ORIGINS=https://www.numistr.org,http://localhost:3000

# ===== Performance =====
# Set to 'true' to enable GPU (requires CUDA and faiss-gpu)
USE_GPU=false
